<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SGFP - Modulo Movimientos (web)</display-name>

    <!-- Servlet controlador del modulo Movimientos -->
    <servlet>
        <servlet-name>MovimientoServlet</servlet-name>
        <servlet-class>co.edu.sena.finanzas.servlet.MovimientoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovimientoServlet</servlet-name>
        <url-pattern>/movimientos</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Cualquier error no controlado se muestra en una pagina amigable -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
</web-app>
